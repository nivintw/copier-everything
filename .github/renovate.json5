//
// The fleet's shared rules come from nivintw/repo-management's renovate/default.json5, pinned to
// a release tag that Renovate bumps (with the reusable workflow's pin in
// .github/workflows/renovate.yml) when repo-management releases. The rules below are this
// repo's own: they teach Renovate the pins inside template/**/*.jinja, which no built-in manager
// reads, and they apply after default.json5's, so they win where both match.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>nivintw/repo-management//renovate/default.json5#v2.2.0"],
  packageRules: [
    // The pins inside template/**/*.jinja are found by the regex managers below, not by the
    // built-in managers default.json5 groups by, so put them in the same ecosystem groups and
    // give the template's action pins the same 3-day Actions wait.
    {
      description: "Action pins in the generated workflows: the Actions group, minus the two release-privilege actions (their own PRs, as in default.json5).",
      matchManagers: ["custom.regex"],
      matchFileNames: ["template/.github/workflows/**"],
      matchDatasources: ["github-tags"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      matchPackageNames: ["!actions/create-github-app-token", "!googleapis/release-please-action"],
      groupName: "GitHub Actions (non-major)",
    },
    {
      description: "Action pins in the generated workflows wait 3 days, like every other action. The two release-privilege actions keep default.json5's 14 days.",
      matchManagers: ["custom.regex"],
      matchFileNames: ["template/.github/workflows/**"],
      matchDatasources: ["github-tags"],
      matchPackageNames: ["!actions/create-github-app-token", "!googleapis/release-please-action"],
      minimumReleaseAge: "3 days",
    },
    {
      description: "pre-commit hook revs in the generated config: the pre-commit group.",
      matchManagers: ["custom.regex"],
      matchFileNames: ["template/.pre-commit-config.yaml.jinja"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      groupName: "pre-commit hooks (non-major)",
    },
    {
      description: "Ruff keeps its own group in the generated config too.",
      matchManagers: ["custom.regex"],
      matchPackageNames: ["astral-sh/ruff-pre-commit"],
      groupName: "ruff",
    },
    {
      description: "The uv image in the generated Dockerfile: the Docker group.",
      matchManagers: ["custom.regex"],
      matchDatasources: ["docker"],
      matchUpdateTypes: ["minor", "patch", "pin", "digest"],
      groupName: "Docker images (non-major)",
    },
    {
      description: "Run the checksum refresh over the template's generated workflows too.",
      matchPackageNames: [
        "aquasecurity/trivy",
        "google/osv-scanner",
        "korandoru/hawkeye",
        "tamasfe/taplo",
        "yannh/kubeconform",
        "bats-core/bats-core",
        "gitleaks/gitleaks",
      ],
      postUpgradeTasks: {
        commands: ["scripts/refresh-binary-checksums.sh"],
        fileFilters: [".github/workflows/**", "template/.github/workflows/**"],
        executionMode: "branch",
      },
    },
    {
      description: "The template's own repo-management pins (its shim's preset tag and its caller's reusable-workflow pin) move with the root's, in default.json5's no-wait group, so a generated project starts on the same release as this repo.",
      matchManagers: ["custom.regex"],
      matchFileNames: ["template/.github/renovate.json5.jinja", "template/.github/workflows/renovate.yml.jinja"],
      matchPackageNames: ["nivintw/repo-management"],
      groupName: "nivintw/repo-management shared Renovate config",
      minimumReleaseAge: null,
    },
    {
      description: "trivy keeps default.json5's own group in the template too (the pre-commit rule above would otherwise claim its hook pins): a grouped branch runs postUpgradeTasks from its first update, so in a larger group the TRIVY_SHA256 refresh is skipped.",
      matchDatasources: ["github-releases"],
      matchPackageNames: ["aquasecurity/trivy"],
      groupName: "trivy",
    },
  ],
  customManagers: [
    {
      customType: "regex",
      description: "pre-commit hook revs pinned inside the generated .pre-commit-config.yaml.jinja.",
      managerFilePatterns: ["/^template/\\.pre-commit-config\\.yaml\\.jinja$/"],
      matchStrings: [
        "repo:\\s+https://github\\.com/(?<depName>[^\\s/]+/[^\\s/]+)\\s+rev:\\s+(?<currentValue>\\S+)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "SHA-pinned actions inside the generated workflow .jinja files.",
      managerFilePatterns: ["/^template/\\.github/workflows/.+\\.jinja$/"],
      matchStrings: [
        "uses:\\s+(?<depName>[\\w.-]+/[\\w.-]+)@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+(?<currentValue>v\\S+)",
      ],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "Release binaries pinned by a `# renovate:`-annotated *_VERSION env var in the generated workflows.",
      managerFilePatterns: ["/^template/\\.github/workflows/.+\\.jinja$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+\\w+: \"(?<currentValue>[^\"]+)\"",
      ],
    },
    {
      customType: "regex",
      description: "uv image pinned in the generated Dockerfile.jinja (the docker manager can't parse .jinja).",
      managerFilePatterns: ["/Dockerfile.*\\.jinja$/"],
      matchStrings: ["COPY --from=(?<depName>ghcr\\.io/astral-sh/uv):(?<currentValue>\\S+) "],
      datasourceTemplate: "docker",
    },
    {
      customType: "regex",
      description: "prek pinned in copier.yml and the generated docs and configs, bumped together with every other occurrence.",
      managerFilePatterns: [
        "/^copier\\.yml$/",
        "/^template/\\.github/workflows/.+\\.jinja$/",
        "/^template/AGENTS\\.md\\.jinja$/",
        "/^template/README\\.md\\.jinja$/",
        "/^template/CONTRIBUTING\\.md\\.jinja$/",
        "/^template/\\.github/PULL_REQUEST_TEMPLATE\\.md\\.jinja$/",
        "/^template/\\.pre-commit-config\\.yaml\\.jinja$/",
      ],
      matchStrings: ["uvx prek@(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"],
      datasourceTemplate: "pypi",
      depNameTemplate: "prek",
    },
    {
      customType: "regex",
      description: "Hook tools installed by prek's `language: mise` in the generated config, pinned as a mise tool spec in additional_dependencies (`aqua:owner/repo@X.Y.Z` or `github:owner/repo@X.Y.Z`). Both backends install the tool's GitHub release.",
      managerFilePatterns: ["/^template/\\.pre-commit-config\\.yaml\\.jinja$/"],
      matchStrings: ["\"(?:aqua|github):(?<depName>[^/\"@\\s]+/[^\"@\\s]+)@(?<currentValue>[^\"\\s]+)\""],
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "The mise CLI prek downloads to install those tools in the generated config, pinned through default_language_version (`mise: \"=X.Y.Z\"`). Only the version after the `=` is replaced.",
      managerFilePatterns: ["/^template/\\.pre-commit-config\\.yaml\\.jinja$/"],
      matchStrings: ["\\bmise:\\s*\"=(?<currentValue>[^\"]+)\""],
      datasourceTemplate: "github-releases",
      depNameTemplate: "jdx/mise",
      extractVersionTemplate: "^v?(?<version>.+)$",
    },
    {
      customType: "regex",
      description: "The repo-management preset tag in the generated project's renovate.json5 shim (the renovate-config manager can't parse .jinja).",
      managerFilePatterns: ["/^template/\\.github/renovate\\.json5\\.jinja$/"],
      matchStrings: ["github>(?<depName>nivintw/repo-management)//renovate/default\\.json5#(?<currentValue>v[^\"]+)\""],
      datasourceTemplate: "github-tags",
    },
    {
      customType: "regex",
      description: "The generated project's call to repo-management's reusable Renovate workflow, SHA-pinned with a tag comment. The action manager above needs `owner/repo@`, so it never sees a reusable-workflow path.",
      managerFilePatterns: ["/^template/\\.github/workflows/renovate\\.yml\\.jinja$/"],
      matchStrings: [
        "uses:\\s+(?<depName>nivintw/repo-management)/\\.github/workflows/[\\w.-]+@(?<currentDigest>[a-f0-9]{40})\\s+#\\s+(?<currentValue>v\\S+)",
      ],
      datasourceTemplate: "github-tags",
    },
  ],
}
