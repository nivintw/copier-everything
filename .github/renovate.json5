//
// Shim. The fleet's rules live in nivintw/repo-management's renovate/default.json5; this repo
// also extends copier-template.json5, which teaches Renovate the pins inside template/**/*.jinja.
// Both are pinned to the same release tag, which Renovate bumps (together with the reusable
// workflow's pin in .github/workflows/renovate.yml) when repo-management releases.
{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "github>nivintw/repo-management//renovate/default.json5#v2.1.1",
    "github>nivintw/repo-management//renovate/copier-template.json5#v2.1.1",
  ],
}
