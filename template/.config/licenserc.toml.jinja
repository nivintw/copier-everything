# SPDX-FileCopyrightText: © {{ year }} {{ author_name }}
# SPDX-License-Identifier: {{ license }}

# hawkeye (https://github.com/fast/hawkeye) — inserts & maintains SPDX license
# headers for REUSE compliance. Run: `hawkeye format` (or `check`). Header text is
# templated from [props] so year/holder/license live in one place. Only files
# with no usable comment syntax stay in REUSE.toml (strict JSON, lockfiles).

# REUSE-IgnoreStart — this template literally contains an SPDX-License-Identifier line;
# without the guard, `reuse lint` tries to parse the placeholder as a license.
[header]
text = """
SPDX-FileCopyrightText: © {{ '{{' }} props.inception_year {{ '}}' }} {{ '{{' }} props.copyright_holder {{ '}}' }}
SPDX-License-Identifier: {{ '{{' }} props.spdx_license_identifier {{ '}}' }}
"""
# REUSE-IgnoreEnd

[files]
root = ".."
{%- if markdown_has_frontmatter %}
# This project has frontmatter-first markdown (YAML on line 1 — Claude Code skills,
# Jekyll/Hugo), so markdown is explicitly excluded (a line-1 SPDX comment would break
# the frontmatter) and is licensed via REUSE.toml instead.
{%- endif %}
excludes = [
  "LICENSE",
  "LICENSES/**",
  "uv.lock",
  "**/*.json",
{%- if markdown_has_frontmatter %}
  "**/*.md",
{%- endif %}
  "**/.gitignore",
  "docs/assets/favicon.svg",
  "**/.python-version",
  "**/.vscode/*",
  # CODEOWNERS has no extension hawkeye maps; it carries its own `#` header (reuse-verified).
  "**/CODEOWNERS",
  # GitHub's issue-form parser silently rejects a form whose YAML begins with a comment (it
  # falls back to a blank issue), so ISSUE_TEMPLATE/*.yml must start with the form keys and
  # can't carry an inline SPDX header — excluded here and licensed via REUSE.toml instead.
  ".github/ISSUE_TEMPLATE/**",
  # The Claude Code guard hooks ship verbatim from the template (no per-file templating), so
  # they carry no inline header — excluded here and licensed via REUSE.toml instead.
  ".claude/hooks/**",
{%- if include_helm %}
  "**/Chart.lock",
{%- endif %}
{%- if include_sql %}
  # hawkeye doesn't map the `.sqlfluff` filename; it carries its own `#` header (verified
  # by reuse), so tell hawkeye to skip it rather than warn about an unknown file.
  "**/.sqlfluff",
{%- endif %}
]
{% if not markdown_has_frontmatter %}
[[rules]]
extensions = ["md"]
style_out = "xml"
{% endif %}
# '#'-comment files hawkeye doesn't map by default. (.gitignore is explicitly excluded and
# licensed via REUSE.toml instead — see that file.)
[[rules]]
extensions = ["txt", "fish", "bats"{% if include_terraform %}, "tf"{% endif %}{% if has_ansible %}, "cfg"{% endif %}{% if include_helm %}, "tpl"{% endif %}]
{%- set script_style_filenames = [] %}
{%- if has_python %}{% set _ = script_style_filenames.append('".envrc"') %}{% endif %}
{%- if include_docker %}{% set _ = script_style_filenames.append('".dockerignore"') %}{% endif %}
{%- if include_helm %}{% set _ = script_style_filenames.append('".helmignore"') %}{% endif %}
filenames = [{{ script_style_filenames|join(", ") }}]
style_out = "script"

[props]
inception_year = "{{ year }}"
spdx_license_identifier = "{{ license }}"
copyright_holder = "{{ author_name }}"
