# SPDX-License-Identifier: {{ license }}

# CI — the shared lint/format/test gate. REUSABLE (on: workflow_call); the triggers
# live in the callers:
#   - pr.yml    (on: pull_request)  → this gate. The open-PR pipeline.
#   - main.yml  (on: push to main)  → this gate, THEN a release-please stage.
# Defining the gate once means both pipelines run the exact same checks.
#
# Most prek hooks self-bootstrap their pinned env. taplo + hawkeye are `language:
# system` (they expect local binaries), so prek skips them here and they run as their
# own steps below, fetching the pinned upstream release — same check, no Docker.

name: ci

on:
  workflow_call:
    inputs:
      skip-quality-gate:
        description: >-
          When true, skip the heavy lint/format/test steps but still report success.
          main.yml sets this for release-please's bump commit (already validated as the
          Release PR), so a release doesn't re-run the full gate (doubled minutes). Callers'
          `needs: ci` is unaffected because the job still succeeds.
        type: boolean
        default: false
{% if has_ansible %}    secrets:
      CI_APP_PRIVATE_KEY:
        description: >-
          The fleet CI App's private key. Used only to mint a read-only token so
          `ansible-galaxy install` can fetch private collections and roles that requirements.yml
          pulls from this owner's GitHub repos. Optional: without it, public content still
          installs and a private dependency fails loudly.
        required: false
{% endif %}
permissions:
  contents: read

# Distinct group prefix from the real callers' own (pr-/release-) so an identical github.ref
# never collides with a caller's group — colliding names would cancel the caller mid-flight.
concurrency:
  group: ci-${{ '{{' }} github.ref {{ '}}' }}
  cancel-in-progress: true

jobs:
  secret-scan:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # fetch-depth: 0 so gitleaks scans the WHOLE history, not just the tip. The pre-commit
          # `gitleaks --staged` hook is a no-op in CI's clean checkout (nothing is staged), so
          # without this job a generated project ships effectively zero CI secret scanning — and
          # a secret committed then removed in a later commit is invisible to a tip-only scan.
          fetch-depth: 0
          # Read-only gate — don't leave the checkout token in .git/config (zizmor artipacked).
          persist-credentials: false
      - name: Scan full git history for secrets (gitleaks)
        if: inputs.skip-quality-gate != true
        env:
          # renovate: datasource=github-releases depName=gitleaks/gitleaks
          GITLEAKS_VERSION: "8.30.1"
          # SHA256 of gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz — refreshed with the version
          # by scripts/refresh-binary-checksums.sh.
          GITLEAKS_SHA256: "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"  # gitleaks:allow
        run: |
          set -euo pipefail
          # Fail loudly on a shallow checkout rather than silently scanning a partial history —
          # a shallow clone would turn this full-history scan into a false all-clear.
          if [ "$(git rev-parse --is-shallow-repository)" = "true" ]; then
            echo "::error::Checkout is shallow — gitleaks would scan only partial history. Ensure fetch-depth: 0."
            exit 1
          fi
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 60 \
            "https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz" \
            -o "$RUNNER_TEMP/gitleaks.tar.gz"
          echo "${GITLEAKS_SHA256}  $RUNNER_TEMP/gitleaks.tar.gz" | sha256sum -c -
          tar -xz -C "$RUNNER_TEMP" -f "$RUNNER_TEMP/gitleaks.tar.gz" gitleaks
          "$RUNNER_TEMP/gitleaks" git --redact --verbose .

  lint-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          # Read-only gate — don't leave the checkout token in .git/config (zizmor artipacked).
          persist-credentials: false
          # Full history, so the binary-pin check below can compare against the PR's base commit.
          fetch-depth: 0

      - name: Binary pins only move with their version
        # A *_SHA256 / *_COMMIT pin that changes while its *_VERSION doesn't is a release asset
        # swapped on a published tag, or a hand edit hiding one. Inside this required check so
        # it blocks the merge, Renovate's included.
        if: github.event_name == 'pull_request'
        env:
          BASE_SHA: ${{ '{{' }} github.event.pull_request.base.sha {{ '}}' }}
        run: scripts/check-binary-pins.sh "$BASE_SHA"

      - name: Set up uv (+ managed Python)
        uses: astral-sh/setup-uv@68559e99cc807c1eb7e9238fd43a15bba460eec2 # v10.3.3
        with:
          enable-cache: true

      - name: Cache prek hook environments
        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
        with:
          path: ~/.cache/prek
          key: prek-${{ '{{' }} hashFiles('.pre-commit-config.yaml') {{ '}}' }}
          # Fall back to any prior prek cache so a hook-rev bump rebuilds only the changed
          # env (not all of them) — matters more now there are more, oftener-bumped hooks.
          restore-keys: |
            prek-
{% if include_terraform or include_docker %}
      - name: Install trivy (Dockerfile/IaC scan — runs inside the prek gate)
        if: inputs.skip-quality-gate != true
        env:
          # renovate: datasource=github-releases depName=aquasecurity/trivy
          TRIVY_VERSION: "0.71.2"
          # SHA256 of trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz — refreshed with the version
          # by scripts/refresh-binary-checksums.sh (run as a Renovate postUpgradeTask).
          TRIVY_SHA256: "0510e71e2fd39bf863856d499c8dc19feb4e7336546394c502a8f5cc7ab27460"  # gitleaks:allow
        run: |
          set -euo pipefail
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 60 \
            "https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz" \
            -o "$RUNNER_TEMP/trivy.tar.gz"
          echo "${TRIVY_SHA256}  $RUNNER_TEMP/trivy.tar.gz" | sha256sum -c -
          tar -xz -C "$RUNNER_TEMP" -f "$RUNNER_TEMP/trivy.tar.gz" trivy
          echo "$RUNNER_TEMP" >>"$GITHUB_PATH"
{% endif %}{% if has_python %}
      - name: Install osv-scanner (dependency CVE scan — runs inside the prek gate)
        if: inputs.skip-quality-gate != true
        env:
          # renovate: datasource=github-releases depName=google/osv-scanner
          OSV_VERSION: "2.7.1"
          # SHA256 of osv-scanner_linux_amd64 (the published asset is the bare binary) —
          # refreshed with the version by scripts/refresh-binary-checksums.sh.
          OSV_SHA256: "fb7dab19a8bd9bbe5c3189f09d4b7ee1820c9553a23bac202648a56efd2f6ee8"  # gitleaks:allow
        run: |
          set -euo pipefail
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 60 \
            "https://github.com/google/osv-scanner/releases/download/v${OSV_VERSION}/osv-scanner_linux_amd64" \
            -o "$RUNNER_TEMP/osv-scanner"
          echo "${OSV_SHA256}  $RUNNER_TEMP/osv-scanner" | sha256sum -c -
          chmod +x "$RUNNER_TEMP/osv-scanner"
          echo "$RUNNER_TEMP" >>"$GITHUB_PATH"
{% endif %}{% if include_terraform %}
      - name: Set up Terraform (backs the terraform_fmt/validate prek hooks)
        if: inputs.skip-quality-gate != true
        uses: hashicorp/setup-terraform@dfe3c3f87815947d99a8997f908cb6525fc44e9e # v4.0.1
        with:
          # The default wrapper rewrites `terraform` to emit extra output, which breaks the
          # terraform_validate hook's JSON parsing. Disable it so the hook sees raw output.
          terraform_wrapper: false
      - name: Set up tflint (backs the terraform_tflint prek hook)
        if: inputs.skip-quality-gate != true
        uses: terraform-linters/setup-tflint@6ffdbaa3be476b3431f7275c26966ef32ff60337 # v6.3.2
{% endif %}{% if include_helm %}
      - name: Set up Helm (backs the helm-lint prek hook + the kubeconform step below)
        if: inputs.skip-quality-gate != true
        uses: azure/setup-helm@2f5e7bc67f1f9972ab16657bb795f36d8f04de0e # v5.1.0
{% endif %}{% if has_ansible %}
      - name: Find this owner's GitHub repos that requirements.yml pulls
        # The token below is scoped to exactly these repos, so it can't read anything else.
        id: deps
        if: inputs.skip-quality-gate != true
        env:
          OWNER: ${{ '{{' }} github.repository_owner {{ '}}' }}
        run: |
          set -euo pipefail
          # Both URL forms: https://github.com/OWNER/REPO(.git) and git@github.com:OWNER/REPO(.git).
          names="$(grep -oE "github\.com[:/]${OWNER}/[A-Za-z0-9._-]+" requirements.yml \
            | sed -E "s#.*/##; s#\.git\$##" | sort -u | paste -sd, - || true)"
          echo "names=${names}" >>"$GITHUB_OUTPUT"

      - name: Mint a read-only token for those repos
        # The default GITHUB_TOKEN is scoped to this repo, so it can't read a private dependency.
        # The fleet CI App can: this mints a contents:read token for exactly the repos found
        # above, used by the next step alone. Skipped when there are none or the App isn't
        # configured (public content still installs; a private dependency then fails loudly).
        id: deps-token
        if: inputs.skip-quality-gate != true && steps.deps.outputs.names != '' && vars.CI_CLIENT_ID != ''
        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3.3.0
        with:
          client-id: ${{ '{{' }} vars.CI_CLIENT_ID {{ '}}' }}
          private-key: ${{ '{{' }} secrets.CI_APP_PRIVATE_KEY {{ '}}' }}
          repositories: ${{ '{{' }} steps.deps.outputs.names {{ '}}' }}
          permission-contents: read

      - name: Install Galaxy content (so ansible-lint resolves collections in the prek gate)
        if: inputs.skip-quality-gate != true
        # ansible-lint (a prek hook) resolves Galaxy collections from Ansible's default path;
        # install the project's requirements.yml there before the gate runs. uvx pulls a pinned
        # ansible-core on demand — no pyproject/venv. Renovate bumps the pin.
        env:
          # renovate: datasource=pypi depName=ansible-core
          ANSIBLE_CORE_VERSION: "2.22.0"
          DEPS_TOKEN: ${{ '{{' }} steps.deps-token.outputs.token {{ '}}' }}
        run: |
          set -euo pipefail
          if [ -n "${DEPS_TOKEN}" ]; then
            # Rewrite GitHub git URLs (https and ssh forms) to carry the read-only token, through
            # GIT_CONFIG_* so it lives in this step's environment only, never in a config file.
            export GIT_CONFIG_COUNT=2
            export GIT_CONFIG_KEY_0="url.https://x-access-token:${DEPS_TOKEN}@github.com/.insteadOf"
            export GIT_CONFIG_VALUE_0="https://github.com/"
            export GIT_CONFIG_KEY_1="url.https://x-access-token:${DEPS_TOKEN}@github.com/.insteadOf"
            export GIT_CONFIG_VALUE_1="git@github.com:"
          fi
          uvx --from "ansible-core==${ANSIBLE_CORE_VERSION}" ansible-galaxy install -r requirements.yml
{% endif %}
      - name: Run prek hooks (same as local)
        if: inputs.skip-quality-gate != true
        env:
          # taplo/hawkeye run as dedicated steps below; no-commit-to-branch is a
          # commit-time guard meaningless in CI (we're checked out on the branch). zizmor
          # runs --offline in the hook (token-free local gate) and is SKIP'd here so CI
          # runs the FULL online audit as the dedicated step below instead.
          SKIP: taplo,hawkeye-format,no-commit-to-branch,zizmor
        run: uvx prek@0.5.10 run --all-files

      - name: Audit workflows for security issues (zizmor, online)
        if: inputs.skip-quality-gate != true
        # The prek zizmor hook is --offline (deterministic, token-free) and SKIP'd above, so
        # CI runs the full audit here — the network audits (known-vulnerable-actions,
        # ref-confusion) need a GH token; the AST audits run as in the hook. Pinned to the
        # hook's zizmor version; contents:read suffices to query the advisory DB + resolve refs.
        env:
          GH_TOKEN: ${{ '{{' }} github.token {{ '}}' }}
          # renovate: datasource=pypi depName=zizmor
          ZIZMOR_VERSION: "1.32.0"
        run: uvx "zizmor@${ZIZMOR_VERSION}" --no-progress .github/workflows/

      - name: Check SPDX license headers (hawkeye)
        if: inputs.skip-quality-gate != true
        env:
          # renovate: datasource=github-releases depName=korandoru/hawkeye
          HAWKEYE_VERSION: "6.5.1"
          # SHA256 of hawkeye-x86_64-unknown-linux-gnu.tar.xz — refreshed with the version
          # by scripts/refresh-binary-checksums.sh.
          HAWKEYE_SHA256: "d6eb0505a45a15244f4f789158aafe5e3f1a7dc86c9dc1d7651f3cb1e1b321e0"  # gitleaks:allow
        run: |
          set -euo pipefail
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 60 \
            "https://github.com/korandoru/hawkeye/releases/download/v${HAWKEYE_VERSION}/hawkeye-x86_64-unknown-linux-gnu.tar.xz" \
            -o "$RUNNER_TEMP/hawkeye.tar.xz"
          echo "${HAWKEYE_SHA256}  $RUNNER_TEMP/hawkeye.tar.xz" | sha256sum -c -
          tar -xJ --strip-components=1 -C "$RUNNER_TEMP" -f "$RUNNER_TEMP/hawkeye.tar.xz" hawkeye-x86_64-unknown-linux-gnu/hawkeye
          chmod +x "$RUNNER_TEMP/hawkeye"
          "$RUNNER_TEMP/hawkeye" check --config .config/licenserc.toml

      - name: Check TOML formatting (taplo)
        if: inputs.skip-quality-gate != true
        env:
          # renovate: datasource=github-releases depName=tamasfe/taplo
          TAPLO_VERSION: "0.10.0"
          # SHA256 of taplo-linux-x86_64.gz. taplo ships no upstream checksum file, so this is
          # computed from the asset by scripts/refresh-binary-checksums.sh.
          TAPLO_SHA256: "8fe196b894ccf9072f98d4e1013a180306e17d244830b03986ee5e8eabeb6156"  # gitleaks:allow
        run: |
          set -euo pipefail
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 60 \
            "https://github.com/tamasfe/taplo/releases/download/${TAPLO_VERSION}/taplo-linux-x86_64.gz" \
            -o "$RUNNER_TEMP/taplo.gz"
          echo "${TAPLO_SHA256}  $RUNNER_TEMP/taplo.gz" | sha256sum -c -
          gunzip -c "$RUNNER_TEMP/taplo.gz" >"$RUNNER_TEMP/taplo"
          chmod +x "$RUNNER_TEMP/taplo"
          "$RUNNER_TEMP/taplo" fmt --check --diff
{% if 'pytest' in test_frameworks %}
      - name: Tests (pytest)
        if: inputs.skip-quality-gate != true
        run: uv run pytest
{% endif %}{% if 'bats' in test_frameworks %}
      - name: Shell tests (bats)
        if: inputs.skip-quality-gate != true
        # bats publishes no downloadable release asset to checksum, so it's pinned by the git
        # commit its release tag points at (a *_COMMIT pin, refreshed with the version by
        # scripts/refresh-binary-checksums.sh) and installed from that exact commit — closing the
        # unpinned/mutable `apt-get install bats` supply-chain gap. The checkout verifies the
        # pinned commit actually is v${BATS_VERSION}'s tag before installing.
        env:
          # renovate: datasource=github-releases depName=bats-core/bats-core
          BATS_VERSION: "1.14.0"
          # Commit that v${BATS_VERSION}'s tag points at — refreshed with the version by
          # scripts/refresh-binary-checksums.sh (a *_COMMIT pin, not a *_SHA256).
          BATS_COMMIT: "eb7f42f8d608ac693d7a4b67474f6714ea68cfc5"  # gitleaks:allow
        run: |
          set -euo pipefail
          git clone --quiet --filter=blob:none --no-checkout \
            https://github.com/bats-core/bats-core "$RUNNER_TEMP/bats-core"
          git -C "$RUNNER_TEMP/bats-core" checkout --quiet "$BATS_COMMIT"
          # Fail loudly if the pinned commit isn't the one v${BATS_VERSION} tags — a mismatch
          # means the pin drifted from its version (re-run the refresh script).
          tag_commit="$(git -C "$RUNNER_TEMP/bats-core" rev-list -n 1 "v${BATS_VERSION}")"
          if [ "$tag_commit" != "$BATS_COMMIT" ]; then
            echo "::error::BATS_COMMIT ${BATS_COMMIT} != v${BATS_VERSION} tag commit ${tag_commit}"
            exit 1
          fi
          "$RUNNER_TEMP/bats-core/install.sh" "$RUNNER_TEMP/bats-install"
          "$RUNNER_TEMP/bats-install/bin/bats" tests/
{% endif %}{% if include_docker %}
      - name: Build image + scan for CVEs (trivy image)
        if: inputs.skip-quality-gate != true
        # Image-layer CVE scan — needs a *built* image, so it runs here, not in the prek gate
        # (which only scans the Dockerfile via `trivy config`). --ignore-unfixed skips
        # base-image CVEs with no available fix (keeps the gate actionable); HIGH/CRITICAL
        # only. trivy is already on PATH (installed above).
        run: |
          docker build -t {{ project_slug }}:ci .
          trivy image --exit-code 1 --ignore-unfixed --severity HIGH,CRITICAL {{ project_slug }}:ci
{% endif %}{% if include_helm %}
      - name: Validate rendered manifests (kubeconform)
        if: inputs.skip-quality-gate != true
        # `helm lint` runs in the prek gate; kubeconform validates the rendered manifests
        # against upstream Kubernetes schemas (a network fetch), so it runs here.
        # -ignore-missing-schemas: a CRD/Custom Resource the chart adds has no upstream schema;
        # skip those rather than fail (a valid manifest shouldn't redden CI). -strict still
        # rejects unknown fields on the built-in kinds it does know.
        env:
          # renovate: datasource=github-releases depName=yannh/kubeconform
          KUBECONFORM_VERSION: "0.8.0"
          # SHA256 of kubeconform-linux-amd64.tar.gz — refreshed with the version by
          # scripts/refresh-binary-checksums.sh.
          KUBECONFORM_SHA256: "9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883"  # gitleaks:allow
        run: |
          set -euo pipefail
          curl -fsSL --retry 5 --retry-all-errors --retry-delay 2 --retry-max-time 60 \
            "https://github.com/yannh/kubeconform/releases/download/v${KUBECONFORM_VERSION}/kubeconform-linux-amd64.tar.gz" \
            -o "$RUNNER_TEMP/kubeconform.tar.gz"
          echo "${KUBECONFORM_SHA256}  $RUNNER_TEMP/kubeconform.tar.gz" | sha256sum -c -
          tar -xz -C "$RUNNER_TEMP" -f "$RUNNER_TEMP/kubeconform.tar.gz" kubeconform
          helm template helm/{{ project_slug }} | "$RUNNER_TEMP/kubeconform" -strict -ignore-missing-schemas -summary
{% endif %}{% if ansible_role_based %}
      - name: Molecule test (converge · idempotence · verify)
        if: inputs.skip-quality-gate != true
        # ansible-lint + syntax-check run in the prek gate above; Molecule is the integration
        # layer (the pytest analog): it spins a container via the docker driver (Docker is
        # preinstalled on ubuntu-latest) and runs the default scenario — converge, then
        # idempotence, then verify. uvx pulls pinned molecule + the docker driver + ansible-core
        # on demand (no pyproject/venv); the scenario's requirements.yml brings community.docker
        # for the driver. Renovate bumps each pin via the `# renovate:` annotations.
        env:
          # renovate: datasource=pypi depName=molecule
          MOLECULE_VERSION: "26.11.0"
          # renovate: datasource=pypi depName=molecule-plugins
          MOLECULE_PLUGINS_VERSION: "26.11.0"
          # renovate: datasource=pypi depName=ansible-core
          ANSIBLE_CORE_VERSION: "2.22.0"
        run: >-
          uvx --from "molecule==${MOLECULE_VERSION}"
          --with "molecule-plugins[docker]==${MOLECULE_PLUGINS_VERSION}"
          --with "ansible-core==${ANSIBLE_CORE_VERSION}"
          molecule test
{% endif %}